{
  "name": "kitty-open-studio",
  "version": "0.1.0",
  "description": "Kitty Open Studio: open-weights ComfyUI workflows on your own GPU, a Studio to run them, a timeline editor and MCP for Claude and ChatGPT.",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "lint:biome": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "check": "npm run lint:biome && npm run lint && npm run type-check",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:postbuild": "node electron/postbuild.js",
    "electron:dev": "npm run build && npm run electron:postbuild && npm run electron:compile && node electron/launch.js",
    "electron:pack": "npm run build && npm run electron:postbuild && npm run electron:compile && electron-builder --dir",
    "electron:build": "npm run build && npm run electron:postbuild && npm run electron:compile && electron-builder --win",
    "sync-catalog": "node scripts/sync-catalog.mjs",
    "predev": "node scripts/sync-catalog.mjs",
    "prebuild": "node scripts/sync-catalog.mjs",
    "electron:build:linux": "npm run build && npm run electron:postbuild && npm run electron:compile && electron-builder --linux",
    "mcp:stdio": "node mcp/kitty-mcp-stdio.mjs",
    "postinstall": "node scripts/sync-catalog.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/core-mt": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.3",
    "@radix-ui/react-select": "^2.1.3",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.5",
    "@remotion/media-utils": "4.0.486",
    "@remotion/player": "4.0.486",
    "@remotion/preload": "4.0.486",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-virtual": "^3.13.24",
    "@vercel/analytics": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^4.1.0",
    "ffmpeg-static-electron": "^2.0.3",
    "google-auth-library": "^10.6.1",
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.3.0",
    "nanoid": "^5.0.9",
    "next": "^16.2.10",
    "next-intl": "^4.13.1",
    "obscenity": "^0.4.6",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.54.0",
    "react-hotkeys-hook": "^4.6.1",
    "remotion": "4.0.486",
    "synaudio": "^0.4.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "throttle-debounce": "^5.0.2",
    "waveform-path": "^0.0.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@remotion/cli": "^4.0.486",
    "@types/node": "^22.19.12",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/throttle-debounce": "^5.0.2",
    "cross-env": "^10.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.4",
    "husky": "^9.1.7",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.6.0"
  }
}
