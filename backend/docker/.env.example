# Kitty Open Studio backend: copy to .env and edit. Every variable is optional.
# Full reference: docs/docker.md

# pod = JupyterLab + ComfyUI + installer UI (+ SSH); serverless = Runpod job handler
MODE=pod

# Ports inside the container
COMFY_PORT=3020
INSTALLER_PORT=7861
JUPYTER_PORT=8888

# The volume: ComfyUI, its node packs, the Python venv and the models live there (DATA_DIR/ComfyUI, DATA_DIR/venv).
# A pod prepares them on its first start (10-20 minutes); serverless workers use what a pod prepared.
# DATA_DIR=/workspace

# Node packs: all, or comma-separated ids from backend/custom_nodes.json
NODE_PACKS=all
# RTX Video Super Resolution + NVIDIA's nvidia-vfx SDK (proprietary, free on RTX GPUs). false = lanczos instead
INSTALL_NVIDIA_RTX=true
# Extra custom-node repos installed at pod start (URL[@ref], space or comma separated)
CUSTOM_NODES=

# Download models on first boot (only missing files are fetched)
#   INSTALL_PRESET: starter | instant | video | talking-h3 | everything
#   INSTALL_WORKFLOWS / INSTALL_MODELS: comma-separated ids (python installer/cli.py --list)
INSTALL_PRESET=
INSTALL_WORKFLOWS=
INSTALL_MODELS=

# Needed only for gated models (LTX 2.5). Accept the license on the model page first.
HF_TOKEN=

# How results come back from serverless jobs: base64 (small files) or s3 (recommended for video)
OUTPUT_MODE=base64
# S3-compatible storage (Runpod network volume S3 API, Cloudflare R2, AWS S3). See docs/s3.md
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional: a public base URL instead of presigned links, key prefix and link lifetime
S3_PUBLIC_URL=
S3_PREFIX=outputs
S3_PRESIGN_SECONDS=604800

# Pod mode extras
ENABLE_INSTALLER_UI=true
ENABLE_JUPYTER=true
# JupyterLab is a root shell and Runpod's proxy URL works for anyone who has it, so it needs a token.
# Runpod sets JUPYTER_PASSWORD when you tick "Start Jupyter notebook". Both empty = JupyterLab stays off.
JUPYTER_TOKEN=
JUPYTER_PASSWORD=
# true = no login at all (only on a machine nobody else can reach)
JUPYTER_DISABLE_AUTH=

# Attention backend: sdpa (PyTorch, works everywhere) or sage (SageAttention, faster on RTX 30-50;
# built on the pod once per volume and GPU type, 10-30 minutes)
ATTENTION=sdpa
# open-weights: the job handler hides the NVIDIA RTX cards and uses lanczos instead of RTX Video Super Resolution
KITTY_PROFILE=all
# 24gb | 48gb | 80gb: picks FP8 / INT8 / BF16 model variants for the installer and the handler
GPU_PROFILE=48gb

# Job files (ComfyUI input/output, S3 outputs) older than this many days are deleted when someone generates; 0 keeps them
RETENTION_DAYS=3

# Serverless loads only the node packs the cards use (faster cold start); true loads every pack on the volume
SERVERLESS_ALL_NODES=false

# Advanced
# COMFYUI_REF=            (empty = the validated commit pinned in custom_nodes.json)
# TORCH_PACKAGES=torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
# COMFY_ARGS=--reserve-vram 1.5
# BLACKWELL_PATCHES=true
# JOB_TIMEOUT=5400
